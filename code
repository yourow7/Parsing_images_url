import random
import urllib.request
from pathlib import Path
from urllib.error import URLError, HTTPError

names = []
directory = Path(r"C:\Users\youro\PycharmProjects\PythonProject1\trashtwo\myimage")
directory.mkdir(parents=True, exist_ok=True)
def get_image(url):
    while True:
        file_name = f"{random.randrange(1, 10000)}.jpg"
        full_path = directory / file_name
        if not full_path.exists():
            break
    urllib.request.urlretrieve(url, str(full_path))
    names.append(str(full_path))
    return str(full_path)
try:
    file_path = get_image("https://ru.from-locals.com/wp-content/uploads/2021/12/2_29_JaInfo.jpg")
    print("Скачано в:", file_path)
    print("Список файлов:", names)
except (URLError, HTTPError) as e:
    print("Ошибка скачивания:", e)
except Exception as e:
    print("Произошла ошибка:", e)
